# =============================================================================
# Policy Pass AWS Infrastructure - Infra / CI/CD Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Service-specific env vars are in:
#   services/api/.env.example  (Backend)
#   services/ui/.env.example   (Frontend)

# --- AWS Configuration ---
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=

# --- EC2 SSH (for CI/CD) ---
EC2_API_HOST=
EC2_UI_HOST=
EC2_MONITOR_HOST=
EC2_SSH_KEY=

# --- GCS HMAC (for DataSync setup) ---
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET_KEY=

# --- DataSync ---
DATASYNC_TASK_ARN=
