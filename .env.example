# =============================================================================
# Policy Pass AWS Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- AWS Configuration ---
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=355206939988

# --- S3 (FAISS Index Storage) ---
S3_BUCKET=rag-qa-index-355206939988
INDEX_S3_PREFIX=index/
DOWNLOAD_INDEX_FROM_S3=true

# --- GCS (Source - FAISS Index Build) ---
GCS_BUCKET=rag-qna-eval-data
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET_KEY=

# --- MongoDB (GCP VM) ---
MONGODB_URI=mongodb://34.47.80.98:27017
MONGODB_DB=rag_youth_policy

# --- LLM API Keys ---
OPENAI_API_KEY=sk-...
HUGGINGFACE_API_KEY=hf_...

# --- Vertex AI (Claude, Gemini via GCP) ---
VERTEXAI_PROJECT=rag-qna-eval
VERTEXAI_LOCATION=us-east5

# --- Application ---
ENVIRONMENT=production
API_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# --- EC2 SSH (for CI/CD) ---
EC2_API_HOST=
EC2_UI_HOST=
EC2_MONITOR_HOST=
EC2_SSH_KEY=

# --- DataSync ---
DATASYNC_TASK_ARN=
