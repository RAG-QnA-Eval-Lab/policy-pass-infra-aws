# =============================================================================
# Policy Pass - API (Backend) Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# --- AWS ---
AWS_REGION=ap-northeast-2
S3_BUCKET=rag-qa-index-${AWS_ACCOUNT_ID}
INDEX_S3_PREFIX=index/
DOWNLOAD_INDEX_FROM_S3=true

# --- MongoDB (GCP VM) ---
MONGODB_URI=mongodb://34.47.80.98:27017
MONGODB_DB=rag_youth_policy

# --- LLM API Keys ---
OPENAI_API_KEY=sk-...
HUGGINGFACE_API_KEY=hf_...

# --- Vertex AI (Claude, Gemini via GCP) ---
VERTEXAI_PROJECT=rag-qna-eval
VERTEXAI_LOCATION=us-east5

# --- Application ---
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=INFO
